{
  "version": 2,
  "functions": {
    "api/market.js": {
      "maxDuration": 15
    },
    "api/dashboard.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/app.js",
      "destination": "/frontend/app.js"
    },
    {
      "source": "/styles.css",
      "destination": "/frontend/styles.css"
    }
  ]
}
